# Copy to .env for the native Node/SQLite development server. Never commit .env.
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
TYPESAFE_API_KEY=
PINNED_JEV_MODEL=jev-1.13.0
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
RATE_LIMIT_SALT=replace-with-at-least-32-random-bytes
MAX_JEV_CALLS_PER_DAY=5000
JEV_CALLS_PER_HOUR=300
MATCHES_PER_HOUR=60
SESSION_CREATIONS_PER_HOUR=60
# Optional, operator-supplied billing assumptions. Blank means unknown, not free.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
API_REQUESTS_PER_MINUTE=600
ADMIN_ANALYTICS_KEY=
